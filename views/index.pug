extends layout

//- user? {id, name, is_admin} | null
//- alreadyExistsWarning : boolean

block content
  .page
    .header
      h1.text.title Create a new room
    
    form(action="/" method="POST")
      .form-group
        label.text.form-label(for="displayname") Title
        input.form-input#displayname(
          type="text"
          name="displayname"
        )
        label.text.form-label(for="name") URL key. (Letters, digits, hyphens recommended)
        input.form-input#name(
          type="text"
          name="name"
          required
        )
      button.button.button-primary(type="submit") Create room
    if alreadyExistsWarning
      .card
        .text A room with that URL already exists!
