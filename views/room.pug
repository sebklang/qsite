extends layout

//- INPUTS
//- entries[] {id, name, description, created_at}
//- room {id, name, displayname, owner_token}
//- user? {id, name, is_admin} | null

block content
  script(src="/socket.io/socket.io.min.js")
  script(src="/javascripts/list.js")
  script.
    var entries = !{JSON.stringify(entries)}
    var room = !{JSON.stringify(room)}
    var isAdmin = !{isAdmin}

    function setAgeSecondsInEntries(){
      for (const e of entries) {
        e.ageSeconds = Math.max(0, Math.floor(
          (
            new Date().valueOf() - Date.parse(e.created_at)
          ) / 1000
        ))
      }
    }

    function pluralize(num, str) {
      if (num != 1) return `${num} ${str}s`
      else return `1 ${str}`
    }

    function agoify(diff) {
      let diffStr = ""

      const days = Math.floor(diff / 3600 / 24)
      diff -= days * 24 * 3600
      const hours = Math.floor(diff / 3600)
      diff -= hours * 3600
      const minutes = Math.floor(diff / 60)
      diff -= minutes * 60
      const seconds = Math.floor(diff)

      if (days > 0)
          diffStr = `${pluralize(days, "day")}`
      else if (hours > 0)
          diffStr = `${pluralize(hours, "hour")} ${pluralize(minutes, "minute")}`
      else if (minutes > 0)
          diffStr = `${pluralize(minutes, "minute")}`
      else if (seconds)
          diffStr = `${pluralize(seconds, "second")}`
      else
          diffStr = 'now'
      if (diffStr != 'now')
          diffStr += ' ago'
      return diffStr
    }

    function renderList() {
      const placeholder = document.getElementById('list-placeholder')
      placeholder.innerHTML = template({
        entries: entries,
        room: room,
        isAdmin: isAdmin
      })

      const waitingLabel = document.getElementById('nwaiting')
      if (waitingLabel) {
        waitingLabel.textContent = `${entries.length} people waiting`
      }

      const timeEntries = placeholder.getElementsByClassName('list-entry-secondary')
      for (let i = 0; i < timeEntries.length; i++) {
        if (entries[i]) {
          timeEntries[i].innerHTML = agoify(entries[i].ageSeconds)
        }
      }
    }

    const socket = io({ transports: ['websocket'] })
    socket.emit('room:join', room.name)
    socket.on('room:update', ({ entries: newEntries }) => {
      entries = newEntries
      setAgeSecondsInEntries()
      renderList()
    })

    function updateList() {
      setAgeSecondsInEntries()
      const waitingLabel = document.getElementById('nwaiting')
      if (waitingLabel) {
        waitingLabel.textContent = `${entries.length} people waiting`
      }
      const timeEntries = document.getElementsByClassName('list-entry-secondary')
      for (let i = 0; i < timeEntries.length; i++) {
        if (entries[i]) {
          timeEntries[i].innerHTML = agoify(entries[i].ageSeconds)
        }
      }
    }

    window.onload = () => {
      setAgeSecondsInEntries()
      renderList()
      setInterval(updateList, 1000)
    }

  .page
    .header
      h1.text.title= `${room.displayname || "Unnamed queue"}`
      p.text.subtitle#nwaiting #{entries.length} people waiting
    #list-placeholder
      .list
        each entry, i in entries
          .list-entry
            .text.list-entry-position= i + 1
            .list-entry-content
              .text.list-entry-name= entry.name
              if entry.description
                .text.list-entry-description= entry.description
              .text.list-entry-secondary= entry.ageSeconds
            //- Delete button
            if (entry.isDeletable || isAdmin)
              form(action=`/${room.name}${isAdmin?'/secret':''}` method="post")
                input#delete(type="hidden", name="delete", value="true")
                input#roomId(type="hidden", name="roomId", value=`${room.id}`)
                input#roomName(type="hidden", name="roomName", value=`${room.name}`)
                input#entryId(type="hidden", name="entryId", value=`${entry.id}`)
                button.button.button-primary(type="submit") Finished
    

    //- Join queue form
    .card()
      h2.text.mt-0 Join queue
      form(action=`/${room.name}${isAdmin?'/secret':''}` method="POST")  
        .form-group
            label.text.form-label(for="name") Name(s) / group name / desk number
            input.form-input#name(
              type="text"
              name="name"
              required
            )
            label.text.form-label(for="description") Optional information (meeting links etc.)
            textarea.form-input.description-input#description(
              name="description"
              rows="5"
            )
            input#roomId(
              type="hidden"
              name="roomId"
              value=room.id
            )
        button.button.button-primary(type="submit") Join queue
